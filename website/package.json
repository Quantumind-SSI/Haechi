{
  "name": "haechi-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Haechi enterprise secure communications website",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node tests/smoke.mjs && node --test tests/functions.test.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node server.mjs --prod",
    "pages:build": "node scripts/pages-build.mjs",
    "pages:dev": "wrangler pages dev public",
    "pages:deploy": "wrangler pages deploy public"
  },
  "engines": {
    "node": ">=20"
  }
}
