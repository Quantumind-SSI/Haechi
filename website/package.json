{
  "name": "haechi-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Haechi enterprise secure communications website",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node scripts/check-brand-palette.mjs && node --test --test-timeout=60000 && node tests/smoke.mjs",
    "migrate": "node migrate.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node server.mjs --prod",
    "pages:build": "node scripts/pages-build.mjs",
    "pages:dev": "wrangler pages dev public",
    "pages:deploy": "wrangler pages deploy public",
    "check:brand": "node scripts/check-brand-palette.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "8.23.0",
    "motion": "^15.0.0"
  }
}
